# JRSY Firebase configuration.
# Copy this file to ".env" and paste your Firebase web app keys.
# If these are left blank, the app runs in DEMO MODE (seeded data + localStorage).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email address that should be treated as the store admin (demo fallback).
VITE_ADMIN_EMAIL=admin@jrsy.com
